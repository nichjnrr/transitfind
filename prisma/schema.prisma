// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lostReports   LostItem[]
  foundReports  FoundItem[]
}

model LostItem {
  id            String        @id @default(cuid())
  title         String
  description   String
  category      ItemCategory
  transportMode TransportMode
  location      String
  dateTimeOfLoss DateTime
  imageUrl      String?
  status        ItemStatus    @default(OPEN)
  contactEmail  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  userId        String
  user          User          @relation(fields: [userId], references: [id])
}

model FoundItem {
  id            String        @id @default(cuid())
  title         String
  description   String
  category      ItemCategory
  transportMode TransportMode
  location      String
  dateTimeFound DateTime
  imageUrl      String?
  status        ItemStatus    @default(OPEN)
  contactEmail  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  userId        String
  user          User          @relation(fields: [userId], references: [id])
}

enum ItemCategory {
  WALLET
  PHONE
  KEYS
  BAG
  CLOTHING
  ELECTRONICS
  DOCUMENTS
  JEWELLERY
  UMBRELLA
  OTHER
}

enum TransportMode {
  MRT
  BUS
  LRT
  INTERCHANGE
}

enum ItemStatus {
  OPEN
  MATCHED
  CLOSED
}
