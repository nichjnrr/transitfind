// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lostReports   LostItem[]
  foundReports  FoundItem[]
  resetTokens   PasswordResetToken[]
}

model LostItem {
  id            String        @id @default(cuid())
  title         String
  description   String
  category      ItemCategory
  transportMode TransportMode
  location      String
  dateTimeOfLoss DateTime
  imageUrls     String[]      @default([])
  status        ItemStatus    @default(OPEN)
  contactEmail  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  matches       Match[]
}

model FoundItem {
  id            String        @id @default(cuid())
  title         String
  description   String
  category      ItemCategory
  transportMode TransportMode
  location      String
  dateTimeFound DateTime
  imageUrls     String[]      @default([])
  status        ItemStatus    @default(OPEN)
  contactEmail  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  matches       Match[]
}

model Match {
  id          String      @id @default(cuid())
  lostItem    LostItem    @relation(fields: [lostItemId], references: [id], onDelete: Cascade)
  lostItemId  String
  foundItem   FoundItem   @relation(fields: [foundItemId], references: [id], onDelete: Cascade)
  foundItemId String
  score       Int
  status      MatchStatus @default(PENDING)
  confirmedBy String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  @@unique([lostItemId, foundItemId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

enum ItemCategory {
  WALLET
  PHONE
  KEYS
  BAG
  CLOTHING
  ELECTRONICS
  DOCUMENTS
  JEWELLERY
  UMBRELLA
  OTHER
}

enum TransportMode {
  MRT
  BUS
  LRT
  INTERCHANGE
}

enum ItemStatus {
  OPEN
  MATCHED
  CLOSED
}

enum MatchStatus {
  PENDING
  APPROVED
  REJECTED
}
